---
import { Image } from "astro:assets";
import bassFishing from "../assets/Home/bass-fishing.jpg";
import wesleyBurnett from "../assets/Home/wesley-burnett.jpg";
import oneBassOriginal from "../assets/Home/1-bassoriginal.jpg";
import gabrielDiaz from "../assets/Home/gabriel-diaz.jpg";
import gregoryHalliman from "../assets/Home/gregory-halliman.jpg";
import brianNunn from "../assets/Home/brian-nunn2.jpg";
import melvinWilliams from "../assets/Home/melvin-williams.jpg";
import chrisGarcia from "../assets/Home/chris-garcia.jpg";
import christopherDixon from "../assets/Home/christopher-dixon.jpg";
import logoMain from "../assets/logo-main.png";

const articles = [
  {
    title: "Finding Your Secret Spot",
    teaser:
      "Every bass fisherman dreams of finding a secret spot loaded with fish and low pressure.",
    image: bassFishing,
    imageAlt: "Bass fishing on a quiet lake",
    body: [
      "Start by researching public lands managed by city, county, state, and federal agencies.",
      "Use satellite maps to identify hidden ponds, access points, and likely cover before your first trip.",
      "Keep tackle simple on day one, then adapt your setup as you learn the water.",
    ],
  },
  {
    title: "What Makes a Pro Bass Fisherman?",
    teaser:
      "Wesley Burnett shows how planning, discipline, and tournament experience build long-term success.",
    image: wesleyBurnett,
    imageAlt: "Wesley Burnett",
    body: [
      "Burnett advanced from local events to major tournament trails through steady improvement.",
      "He learned from every stage and used each season to sharpen decision making on the water.",
      "A structured approach and patience were key to his rise through the ranks.",
    ],
  },
  {
    title: "Keep It Simple",
    teaser:
      "For new anglers, simpler gear choices can reduce costs and speed up the learning curve.",
    image: oneBassOriginal,
    imageAlt: "Large bass held over water",
    body: [
      "A versatile rod, balanced reel ratio, and practical line setup can cover most situations.",
      "Focus on a small set of productive bait colors matched to water clarity and conditions.",
      "Master the basics first, then expand techniques and tackle as confidence grows.",
    ],
  },
];

const teamMembers = [
  {
    name: "Gabriel Diaz",
    photo: gabrielDiaz,
    teaser: "",
    body: [""],
  },
  {
    name: "Gregory Halliman",
    photo: gregoryHalliman,
    teaser:
      "Professional tournament angler with deep Western circuit experience since 1989.",
    body: [
      "Gregory has fished FLW Outdoors, B.A.S.S., W.O.N. Bass, and team tournaments, including the FLW Rayovac Series.",
      "He has earned Big Fish awards across major Western divisions and qualified for the FLW EverStart Championship in 2005 and 2013. He also owns and operates a management retail consulting business and works in the motion picture industry as an actor.",
    ],
  },
  {
    name: "Brian Nunn",
    photo: brianNunn,
    teaser:
      "Accomplished ABA competitor with proven championship-level consistency.",
    body: [
      "Brian Nunn was the 2006 A.B.A. Angler of the Year and is a multi-time A.B.A. Championship qualifier at Lake Mead.",
      "He is known for staying versatile and competitive across changing conditions.",
    ],
  },
  {
    name: "Melvin (Mel) Williams",
    photo: melvinWilliams,
    teaser: "Veteran tournament angler competing at a high level since 1987.",
    body: [
      "Mel has competed in circuits including W.O.N. Bass, American Bass, National Bass West, California Bass Federation, FLW Stren, and FLW Rayovac, with highlights such as the W.O.N. US Open and Clear Lake Open.",
      "He qualified for the American Bass, W.O.N., and National Bass West Classics, was a 2007 National Guard FLW qualifier, ranked No. 5 in the 2015 SD Fish power rankings, and placed 5th overall in 2015 California Bass Federation Region 6. He previously worked 18 years at the San Diego Zoo and currently works at UPS.",
    ],
  },
  {
    name: "Chris Garcia",
    photo: chrisGarcia,
    teaser:
      "Competitive angler with strong championship qualifications and trophy fish history.",
    body: [
      "Chris has fished for over 20 years and began competing in recent seasons, qualifying through The Bass Federation for national championships at Lake Havasu (2014) and Lake Shasta (2015).",
      "He also qualified for the 2015 National Bass Championship at Lake Havasu and landed standout California Delta largemouth at 14.2 and 10.3 pounds.",
    ],
  },
  {
    name: "Christopher Dixon",
    photo: christopherDixon,
    teaser:
      "Experienced FLW co-angler who has transitioned to fishing from the front deck.",
    body: [
      "Christopher spent eight years as an FLW co-angler, earning top-10 finishes, championship success in the East-West Fish Off, and feature coverage in FLW Magazine.",
      "He has competed in W.O.N. Bass, Anglers Choice, Future Pro Tour, U.S. Open, Lucas Oil, The Federation, and National Bass, and has multiple first- and second-place trophies. He now competes from the front of the boat in a 2015 Ranger Z520C.",
    ],
  },
];
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(14,116,144,0.16),transparent_45%),radial-gradient(circle_at_bottom_right,rgba(30,41,59,0.12),transparent_38%)]"
  >
  </div>

  <div
    class="relative mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 pt-0 pb-8 sm:px-6 sm:pt-0 sm:pb-12 lg:gap-12 lg:px-8 lg:pt-0 lg:pb-14"
  >
    <header
      class="relative right-1/2 left-1/2 -mx-[50vw] w-screen overflow-hidden border-b border-white/25 bg-[linear-gradient(135deg,#0f172a_0%,#1e293b_38%,#155e75_100%)] py-8 shadow-xl shadow-slate-900/10 sm:py-10 lg:py-12"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(103,232,249,0.22),transparent_44%),radial-gradient(circle_at_80%_80%,rgba(255,255,255,0.12),transparent_36%)]"
      >
      </div>

      <div
        class="relative z-10 mx-auto flex max-w-7xl items-center justify-center px-4 sm:px-6 lg:px-8"
      >
        <Image
          src={logoMain}
          alt="Tournament Proven Finesse Baits"
          class="h-auto w-full max-w-4xl object-contain"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          loading="eager"
          format="webp"
        />
      </div>
    </header>

    <section
      class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"
      aria-label="Featured articles"
    >
      {
        articles.map((article) => (
          <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white/90 shadow-lg shadow-slate-900/5 backdrop-blur">
            <Image
              src={article.image}
              alt={article.imageAlt}
              class="h-52 w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              widths={[480, 720, 960]}
              sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
              loading="eager"
              format="webp"
            />
            <div class="flex flex-1 flex-col p-5">
              <h2 class="text-xl font-bold tracking-tight text-slate-900">
                {article.title}
              </h2>
              <p class="mt-3 text-sm leading-6 text-slate-700">
                {article.teaser}
              </p>

              <details
                data-autocollapse-details
                class="mt-4 rounded-xl bg-slate-50 p-3 open:bg-cyan-50/70"
              >
                <summary class="cursor-pointer text-sm font-semibold text-cyan-800 marker:text-cyan-700">
                  Read more
                </summary>
                <div class="mt-3 space-y-3 text-sm leading-6 text-slate-700">
                  {article.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </details>
            </div>
          </article>
        ))
      }
    </section>

    <section
      class="grid gap-6 lg:grid-cols-[1.2fr_1fr]"
      aria-label="Store and owner highlights"
    >
      <article
        class="rounded-3xl border border-slate-200 bg-white/85 p-6 shadow-lg shadow-slate-900/5 backdrop-blur sm:p-8"
      >
        <div class="flex items-start gap-4">
          <div class="space-y-3">
            <h2 class="text-2xl font-black tracking-tight text-slate-900">
              Visit The Bait Store
            </h2>
            <p class="text-sm leading-7 text-slate-700 sm:text-base">
              True Image worms are built for action, durability, and confidence.
              Explore advanced color patterns, scents, and styles designed for
              multiple bass fishing techniques.
            </p>
            <a
              href="https://www.basstacklemaster.com/SearchResults.asp?Search=True+Image"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center rounded-lg border border-cyan-300/70 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-900 transition hover:bg-cyan-100"
            >
              Open Bait Store
            </a>
          </div>
        </div>
      </article>

      <article
        class="rounded-3xl border border-slate-200 bg-white/85 p-6 shadow-lg shadow-slate-900/5 backdrop-blur sm:p-8"
      >
        <div class="space-y-3">
          <p
            class="text-xs font-semibold tracking-[0.16em] text-cyan-700 uppercase"
          >
            Message From Ray
          </p>
          <h2 class="text-2xl font-black tracking-tight text-slate-900">
            A Lifetime Around The Water
          </h2>
          <p class="text-sm leading-7 text-slate-700 sm:text-base">
            From Texas roots to tournament lessons in the West, Ray continues to
            share practical bass fishing knowledge through True Image products
            and community.
          </p>
          <a
            href="/about"
            class="inline-flex items-center rounded-lg border border-cyan-300/70 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-900 transition hover:bg-cyan-100"
          >
            Read Ray's Story
          </a>
        </div>
      </article>
    </section>

    <section
      class="rounded-3xl border border-slate-200 bg-white/85 p-6 shadow-lg shadow-slate-900/5 backdrop-blur sm:p-8"
      aria-labelledby="team-heading"
    >
      <div class="mb-5 space-y-1 sm:mb-6">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-cyan-700 uppercase"
        >
          Team Members
        </p>
        <h2
          id="team-heading"
          class="text-3xl font-black tracking-tight text-slate-900"
        >
          True Image Bass Team
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          teamMembers.map((member) => {
            const bodyParagraphs = member.body.filter(
              (paragraph) => paragraph.trim().length > 0,
            );
            const hasTeaser = member.teaser.trim().length > 0;
            const hasBody = bodyParagraphs.length > 0;

            return (
              <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition hover:-translate-y-0.5 hover:shadow-md">
                <Image
                  src={member.photo}
                  alt={member.name}
                  class="aspect-square w-full object-cover"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  format="webp"
                />
                <div class="flex flex-1 flex-col px-4 py-3">
                  <p class="text-sm font-semibold tracking-wide text-slate-800">
                    {member.name}
                  </p>

                  {hasTeaser && (
                    <p class="mt-2 text-sm leading-6 text-slate-700">
                      {member.teaser}
                    </p>
                  )}

                  {hasBody && (
                    <details
                      data-autocollapse-details
                      class="mt-3 rounded-xl bg-white/70 p-3 open:bg-cyan-50/70"
                    >
                      <summary class="cursor-pointer text-sm font-semibold text-cyan-800 marker:text-cyan-700">
                        Read more
                      </summary>
                      <div class="mt-2 space-y-2 text-sm leading-6 text-slate-700">
                        {bodyParagraphs.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</section>

<script>
  const detailsItems = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(
      "details[data-autocollapse-details]",
    ),
  );

  const closeAllOpenDetails = () => {
    for (const item of detailsItems) {
      if (item.open) item.open = false;
    }
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const clickedInsideDetails = target.closest(
      "details[data-autocollapse-details]",
    );
    if (!clickedInsideDetails) closeAllOpenDetails();
  });
</script>
